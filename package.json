{
  "name": "m-technovate",
  "version": "1.0.0",
  "description": "M TECHNOVATE — Enterprise IT Company Website & Admin ATS Panel",
  "main": "server/index.js",
  "scripts": {
    "server": "node server/index.js",
    "client": "npm run dev --prefix client",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build": "npm install && npm --prefix client install && npm --prefix client run build",
    "start": "node server/index.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "it-company",
    "enterprise",
    "ats",
    "admin-panel"
  ],
  "author": "M TECHNOVATE",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "concurrently": "^9.1.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "firebase-admin": "^14.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.10.0"
  }
}
